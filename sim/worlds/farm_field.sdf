<?xml version="1.0" ?>
<!--
  Agrican farm field world.

  A minimal agricultural scene: a ground plane, sunlight, the ArduPilot iris
  quadrotor, and rows of "crop" props for the drone to fly over. Static props
  provide something to sense and to navigate around in mission scenarios.

  Run (needs GZ_SIM_RESOURCE_PATH pointing at the ardupilot_gazebo models):
      sim-quiet -v4 -r farm_field.sdf
  then start ArduPilot SITL with the JSON backend as usual (see docs/setup.md).
-->
<sdf version="1.9">
  <world name="farm_field">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Ground: a green field -->
    <model name="field_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.25 0.45 0.15 1</ambient>
            <diffuse>0.30 0.55 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Crop rows: eight long, low green boxes spaced 4 m apart along Y.
      Each row is 20 m long (X), 0.6 m wide, 0.5 m tall - a stand-in for a
      planted row the drone will later scan from above.
    -->
    <model name="crop_row_0"><static>true</static><pose>0 -14 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_1"><static>true</static><pose>0 -10 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_2"><static>true</static><pose>0 -6 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_3"><static>true</static><pose>0 -2 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_4"><static>true</static><pose>0 2 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_5"><static>true</static><pose>0 6 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_6"><static>true</static><pose>0 10 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>
    <model name="crop_row_7"><static>true</static><pose>0 14 0.25 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>20 0.6 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.6 0.5</size></box></geometry><material><ambient>0.15 0.35 0.08 1</ambient><diffuse>0.20 0.45 0.10 1</diffuse></material></visual></link></model>

    <!-- A barn / obstacle at the field edge -->
    <model name="barn">
      <static>true</static>
      <pose>-15 0 2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 8 4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6 8 4</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.6 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The ArduPilot iris quadrotor (JSON FDM link to SITL) -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

  </world>
</sdf>
